{
  "name": "Password Generator Extension",
  "description": "The extension supports generating random password strongest.",
  "version": "1.0.2",
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": "images/password-generator-extension.png"
  },
  "icons": {
    "128": "images/password-generator-extension.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open Password Generator"
    }
  },
  "host_permissions": [],
  "permissions": [
    "storage"
  ],
  "manifest_version": 3
}