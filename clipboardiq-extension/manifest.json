{
  "name": "ClipboardIQ",
  "description": "Smart clipboard manager for support and sales: history, similarity detection, and one-click reply templates with placeholders.",
  "version": "1.0.0",
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/constants.js", "js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "host_permissions": [],
  "permissions": [
    "storage",
    "clipboardWrite",
    "contextMenus"
  ],
  "manifest_version": 3
}
