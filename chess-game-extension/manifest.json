{
  "name": "Chess Game Extension",
  "description": "Play chess right in your browser: 2 players on the same device, or challenge a Minimax + Alpha-Beta AI. Progress and stats are saved automatically.",
  "version": "1.0.0",
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "manifest_version": 3
}
